{
    "name": "pieceofcodero/symlink-composer-plugin",
    "description": "Composer plugin for creating symlinks to packages, files, and folders in custom locations. Supports type-based, vendor-based, name-based, and path-based rules.",
    "type": "composer-plugin",
    "require": {
        "php": "^7.4 || ^8.0",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.8",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Pieceofcodero\\SymlinkComposerPlugin\\": "src/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "Zoli Szabó",
            "email": "zoli.szabo+github@gmail.com"
        }
    ],
    "extra": {
        "class": "Pieceofcodero\\SymlinkComposerPlugin\\Plugin"
    }
}
